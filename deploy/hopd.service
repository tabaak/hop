[Unit]
Description=hop tunnel server
Documentation=https://github.com/tabaak/hop
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hop
Group=hop

# Secrets live here, not in the command line, where `ps` would show them:
#   DNS_PROVIDER=cloudflare
#   CLOUDFLARE_API_TOKEN=...
# (or another provider and its credentials — see `hopd -h` for the list)
#
# Agent tokens are in /etc/hop/tokens instead (see -tokens-file below).
# HOP_TOKENS=token1,token2 still works and is read alongside that file, which
# is how a running deployment migrates without a flag day.
EnvironmentFile=/etc/hop/hopd.env

# This unit assumes hopd runs behind Caddy, which owns :80 and :443:
#
#   -ingress 172.17.0.1:8080  the Docker bridge address, reachable from the
#                             Caddy container but not from the internet.
#                             Confirm with `ip -4 addr show docker0`.
#   -ingress-tls=false        Caddy terminates TLS for tunnel traffic.
#   -scheme https             so agent URLs and X-Forwarded-Proto stay correct
#                             even though the request reaching us is plaintext.
#
# The control listener keeps its own TLS: it speaks hop's protocol, not HTTP,
# so it cannot be proxied. That is why hopd still needs a certificate — just
# the bare name, not the wildcard Caddy holds.
#
# NOTE: -staging=true issues UNTRUSTED certificates against Let's Encrypt's
# staging CA. That is deliberate for the first run — it proves the DNS-01
# challenge works without burning production rate limit. Once the journal shows
# "certificate ready", flip this to -staging=false, delete /var/lib/hop/certs,
# and restart. See deploy/README.md.
#
#   -tokens-file  one `label sha256:hash` line per device, re-read within
#                 seconds of a change. Adding or revoking a device therefore
#                 needs no restart, and revoking disconnects that device
#                 rather than only refusing its next connection. Create it
#                 with `hopd mint <label>`; mode 640, group hop.
ExecStart=/usr/local/bin/hopd \
    -domain hop.vokh.dev \
    -tokens-file /etc/hop/tokens \
    -email viktorr200830@gmail.com \
    -staging=true \
    -cert-dir /var/lib/hop/certs \
    -ingress 172.17.0.1:8080 \
    -ingress-tls=false \
    -scheme https \
    -control :7443

Restart=always
RestartSec=5s

# Creates and owns /var/lib/hop. The ACME account key and certificates live
# here and must survive restarts — losing them means re-issuing, which burns
# Let's Encrypt rate limit.
StateDirectory=hop
StateDirectoryMode=0700

# Both listening ports are above 1024, so no capability to bind low ports is
# needed. Caddy owns :80 and :443.
#
# Running hopd standalone instead — owning :80 and :443 itself — means binding
# privileged ports, which is the usual excuse for running as root. Don't.
# Replace the empty set below with:
#
#   AmbientCapabilities=CAP_NET_BIND_SERVICE
#   CapabilityBoundingSet=CAP_NET_BIND_SERVICE
#
# Both lines are needed: the bounding set caps what the process may ever hold,
# and the ambient set is what it actually starts with. Granting the capability
# is strictly narrower than User=root, which would also permit reading every
# file on the host and rewriting the firewall.
CapabilityBoundingSet=
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
