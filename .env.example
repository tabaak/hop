# Base domain where tunnels will live (e.g. *.hop.yourdomain.com)
DOMAIN=hop.yourdomain.com

# Cloudflare API Token with Zone:DNS:Edit and Zone:Zone:Read permissions
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token

# Email for Let's Encrypt certificate expiry notices
EMAIL=you@example.com

# Use Let's Encrypt staging CA (set to false for real production certificates)
STAGING=true

# Deployment Profile:
# - 'standalone' (default): Claims public ports 80 and 443 exclusively
# - 'proxy': Runs on 127.0.0.1:8080 behind an existing Nginx / Caddy server
COMPOSE_PROFILES=standalone

# Optional: Initial agent token(s), comma-separated.
# If left blank, you can mint tokens anytime via:
#   docker compose exec hopd hopd mint <name> -a /etc/hop/tokens
HOP_TOKENS=

# Optional: Custom TLS certificate (if not using Cloudflare ACME)
# HOP_TLS_CERT=/etc/ssl/certs/fullchain.pem
# HOP_TLS_KEY=/etc/ssl/certs/privkey.pem
