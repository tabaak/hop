# Base domain where tunnels will live (e.g. *.hop.yourdomain.com)
DOMAIN=hop.yourdomain.com

# DNS provider: issues the wildcard certificate and creates the hop and *.hop
# A records on first start. Set the provider's credentials below.
# Supported: bunny, cloudflare, desec, digitalocean, duckdns, gandi, godaddy,
#            hetzner, linode, namecheap, ovh, porkbun, route53, vultr
# (Left empty, cloudflare is used when CLOUDFLARE_API_TOKEN is set.)
DNS_PROVIDER=cloudflare

# Cloudflare API Token with Zone:DNS:Edit and Zone:Zone:Read permissions
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token

# Other providers — uncomment the ones for yours:
# DIGITALOCEAN_TOKEN=
# HETZNER_API_TOKEN=
# PORKBUN_API_KEY=
# PORKBUN_SECRET_API_KEY=
# AWS_ACCESS_KEY_ID=            # route53
# AWS_SECRET_ACCESS_KEY=        # route53
# AWS_REGION=us-east-1          # route53
# GANDI_BEARER_TOKEN=
# NAMECHEAP_API_KEY=
# NAMECHEAP_API_USER=
# GODADDY_TOKEN=key:secret
# DUCKDNS_TOKEN=
# LINODE_TOKEN=
# VULTR_API_KEY=
# DESEC_TOKEN=
# BUNNY_API_KEY=
# OVH_ENDPOINT=ovh-eu
# OVH_APPLICATION_KEY=
# OVH_APPLICATION_SECRET=
# OVH_CONSUMER_KEY=

# Email for Let's Encrypt certificate expiry notices
EMAIL=you@example.com

# Use Let's Encrypt staging CA (set to false for real production certificates)
STAGING=true

# Deployment Profile:
# - 'standalone' (default): Claims public ports 80 and 443 exclusively
# - 'proxy': Publishes plain-HTTP port 8080 (and 7443) instead of 80/443, for use
#   behind an existing Nginx / Caddy server. Keep 8080 closed in your firewall.
COMPOSE_PROFILES=standalone

# Optional: Initial agent token(s), comma-separated.
# If left blank, you can mint tokens anytime via:
#   docker compose exec hopd hopd mint <name> -a /etc/hop/tokens
HOP_TOKENS=

# Optional: Skip creating the A records automatically (hopd then prints them
# and waits for you to add them by hand).
# HOP_MANAGE_DNS=false

# Optional: The IP the A records should point at, if auto-detection picks the
# wrong one (e.g. a floating IP).
# HOP_PUBLIC_IP=

# Optional: Custom TLS certificate (if your DNS provider isn't supported above)
# HOP_TLS_CERT=/etc/ssl/certs/fullchain.pem
# HOP_TLS_KEY=/etc/ssl/certs/privkey.pem
